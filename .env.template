# ============================================================
# YouTube Agent — API Keys & Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Anthropic (Script generation)
# Get at: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs (Voiceover)
# Get at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Find voice IDs at: https://elevenlabs.io/app/voice-library
# Default is a clear male narrator voice
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Pexels (Stock footage)
# Get free at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# YouTube (Upload)
# Path to your OAuth2 client_secrets.json downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# Video Settings
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
MAX_VIDEO_DURATION=60

# Output directory for generated files
OUTPUT_DIR=./output
